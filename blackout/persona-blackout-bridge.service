[Unit]
Description=Persona Quickshell blackout bridge (KWin -> Quickshell IPC)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/persona-blackout-bridge
Environment=PERSONA_SHELL_PATH=%h/Persona-Quickshell
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
